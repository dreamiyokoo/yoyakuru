# データベース
DB_USER=yoyakuru
DB_PASSWORD=change-me
DB_NAME=yoyakuru_dev

# Django
# python -c "import secrets; print(secrets.token_urlsafe(50))" で生成
DJANGO_SECRET_KEY=change-me

# 開発用スーパーユーザー admin のパスワード（setup_tenants --create-superuser で使用）
DJANGO_SUPERUSER_PASSWORD=change-me

# テナント用ベースドメイン（開発は dreami.blog。admin.<domain> と *.<domain> を使う）
TENANT_BASE_DOMAIN=dreami.blog

# docker compose がバインドマウントするリポジトリの絶対パス
HOST_WORKSPACE=/path/to/yoyakuru

# 開発中の公開制限用 Basic 認証（空なら無効）
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# OpenAI（AIチャット・AI電話の検証）
OPENAI_API_KEY=
# チャットのモデル（既定 gpt-4.1-mini）と、店舗ごとの1日あたりのチャット回数の上限
OPENAI_CHAT_MODEL=
CHAT_DAILY_LIMIT_PER_TENANT=300
# 設定用のAIの、店舗ごとの1日あたりの回数（お客様の利用量には数えない）
SETUP_DAILY_LIMIT_PER_TENANT=50
# Googleログイン＋カレンダー連携（Google Cloud の OAuth クライアント。ウェブアプリケーション）
# 承認済みのリダイレクトURI：https://app.<ドメイン>/accounts/google/login/callback/
# 同意画面のスコープ：openid / email / profile / https://www.googleapis.com/auth/calendar.events
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 店舗の月額契約（Stripe）。未設定なら登録はできるが、お支払いは「準備中」になる
# STRIPE_SECRET_KEY はテスト中は sk_test_... を使う。STRIPE_PRICE_ID は月額の価格（price_...）
# Webhook の送信先は https://api.<ドメイン>/api/v1/billing/stripe-webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# 料金の表記（LP・支払いの案内）。空なら Stripe の価格から作る（例：月額1,980円（税込））
PLAN_PRICE_LABEL=
# LPの「体験」から開く体験用店舗の予約ページ（例：https://fushimi.dreami.blog/）。空なら「準備中」
DEMO_STORE_URL=

# メールの差出人（開発では Mailpit が受け、外部には届かない）
DEFAULT_FROM_EMAIL=noreply@dreami.blog

# ---- 以下は実装時に設定する（Issue #2） ----
# お客様の Google ログイン（LOGIN-02）
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# お客様の LINE ログイン（LOGIN-02）
# LINE_LOGIN_CHANNEL_ID=
# LINE_LOGIN_CHANNEL_SECRET=
