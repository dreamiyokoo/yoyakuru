# データベース
DB_USER=yoyakuru
DB_PASSWORD=change-me
DB_NAME=yoyakuru_dev

# Django
# python -c "import secrets; print(secrets.token_urlsafe(50))" で生成
DJANGO_SECRET_KEY=change-me

# 開発用スーパーユーザー（setup_tenants --create-superuser で使用）
DJANGO_SUPERUSER_PASSWORD=change-me

# テナント用ベースドメイン（admin.<domain> と *.<domain> を使う）
TENANT_BASE_DOMAIN=dreami.blog

# docker compose がバインドマウントするリポジトリの絶対パス
HOST_WORKSPACE=/path/to/yoyakuru

# 開発中の公開制限用 Basic 認証（空なら無効）
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
